modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/status && PORT=5000 node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 25104
externalPort = 3000

[userenv]

[userenv.shared]
ADMIN_TELEGRAM_ID = "5067045870"
PAYPAL_ENV = "live"
PAYPAL_ME_USERNAME = "Florentino990"
NODE_ENV = "production"
PORT = "8080"
LTC_ADDRESS = "MEmhJRCuDSfCQdqdPvszdMJcNgNNmVJ5nS"

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "PORT=5000 pnpm --filter @workspace/status run serve & PORT=8080 pnpm --filter @workspace/api-server run start"]
build = ["bash", "-c", "pnpm install --frozen-lockfile && pnpm --filter @workspace/db run push-force && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/status run build"]
