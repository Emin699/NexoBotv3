modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/status && PORT=5000 node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run start"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[userenv]

[userenv.shared]
TELEGRAM_BOT_TOKEN = "8739664701:AAFrOjvVOyMQykmmkMmqE7ixkXUh86FjwWg"
ADMIN_TELEGRAM_ID = "5067045870"
NEON_DATABASE_URL = "postgresql://neondb_owner:npg_bDqyEd4Jr1iW@ep-dry-rice-antfmi2f-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
PAYPAL_ENV = "live"
PAYPAL_ME_USERNAME = "Florentino990"

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "PORT=5000 pnpm --filter @workspace/status run serve & PORT=8080 pnpm --filter @workspace/api-server run start"]
build = ["bash", "-c", "pnpm install --frozen-lockfile && pnpm --filter @workspace/db run push-force && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/status run build"]
